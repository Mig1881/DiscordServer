# ==========================================
# CONFIGURACIÓN DEL SERVIDOR
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# SEGURIDAD (JWT)
# ==========================================
# IMPORTANTE: Cambia JWT_SECRET por una cadena larga y aleatoria en producción.
JWT_SECRET=escribe_aqui_tu_secreto_para_desarrollo
JWT_EXPIRATION=1d

# ==========================================
# BASE DE DATOS (Configuración General)
# ==========================================
# Elige entre 'sqlite' para desarrollo rápido o 'postgres' para Docker/Producción.
DB_TYPE=sqlite

# --- Configuración para SQLite (Desarrollo local) ---
DB_DATABASE=discord_dev.sqlite

# --- Configuración para PostgreSQL (Docker / Producción) ---
# Estas variables son las que Docker Compose usará para levantar el contenedor.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=rootpassword
DB_NAME=discord_db

# ==========================================
# NOTA PARA DOCKER
# ==========================================
# Al usar 'docker-compose up', el sistema ignorará 'DB_TYPE=sqlite' 
# e inyectará automáticamente 'DB_TYPE=postgres' y 'DB_HOST=db'.